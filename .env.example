# Hosted NVIDIA NIM API. For a self-hosted NIM, use e.g. http://localhost:8000/v1.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=nvapi-your-key

# Comma-separated model IDs. You can also pass --model multiple times.
NIM_MODELS=openai/gpt-oss-20b,google/gemma-4-31b-it

# Safe iteration default. The Kaggle notebook used 9000 seconds per model.
AAS_BUDGET_S=60
AAS_MAX_TOOL_HOPS=8
AAS_ATTACK_SEED=123

# Optional path containing aicomp_sdk/ when it is not installed from PyPI.
# AAS_SDK_PATH=/path/to/ai-agent-security-multi-step-tool-attacks

NIM_MAX_TOKENS=4096
NIM_TEMPERATURE=0
NIM_TIMEOUT_S=180
NIM_MAX_RETRIES=3

